{
  "profilo": "generico-senza-test",
  "descrizione": "No test suite: only declared checks (bash -n, valid JSON, shellcheck if installed). The tests gate is NOT RUN (declared).",
  "modulo": {
    "regola_test": "nessuna",
    "controlli": [
      { "glob": "**/*.sh", "comando": "bash -n {file}" },
      { "glob": "**/*.json", "comando": "{python} -m json.tool {file}" },
      { "glob": "**/*.sh", "comando": "shellcheck {file}", "se_presente": "shellcheck" }
    ]
  }
}
