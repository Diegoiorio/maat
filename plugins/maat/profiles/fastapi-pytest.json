{
  "profilo": "fastapi-pytest",
  "descrizione": "Python backend with pytest: mirrored tests (app/…/x.py -> tests/…/test_x*.py), JUnit report, the module's venv interpreter.",
  "modulo": {
    "regola_test": "specchio",
    "specchio": { "da": "app/**/{m}.py", "a": "tests/**/test_{m}*.py" },
    "ambiente": "nativo",
    "report": "junit",
    "comandi": {
      "test": "{python} -m pytest -q --junitxml={report} {test}"
    },
    "controprova": {
      "runner": "pytest",
      "comando": "{python} -B -m pytest {test} -p no:cacheprovider --junitxml={report}"
    },
    "collega_nel_worktree": [".venv"],
    "file_dipendenze": ["requirements*.txt"]
  }
}
