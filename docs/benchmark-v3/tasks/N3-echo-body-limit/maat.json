{
  "versione_schema": 1,
  "harness": ">=1.7",
  "lingua": "en",
  "moduli": [
    {
      "nome": "echo",
      "radice": ".",
      "regola_test": "specchio",
      "specchio": { "da": "**/{m}.go", "a": "**/*_test.go" },
      "ambiente": "nativo",
      "report": "junit",
      "comandi": {
        "test": "python3 .claude/bench/go-junit.py {report} && go vet ./... && : {test}"
      },
      "controlli": [
        { "glob": "**/*.go", "comando": "test -z \"$(gofmt -l {file} | grep -vxE 'echo\\.go|middleware/decompress\\.go')\"", "se_presente": "gofmt" }
      ],
      "file_dipendenze": ["go.mod", "go.sum"]
    }
  ],
  "piattaforma": { "copia_wsl": "no" }
}
