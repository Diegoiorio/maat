{
  "versione_schema": 1,
  "harness": ">=1.5",
  "lingua": "en",
  "moduli": [
    {
      "nome": "minimist",
      "radice": ".",
      "regola_test": "specchio",
      "specchio": { "da": "**/{m}.js", "a": "test/*.js" },
      "ambiente": "nativo",
      "comandi": {
        "test": "npx tape {test}",
        "lint": { "comando": "npx eslint --ext=js,mjs {file}", "cartella": "repo" }
      },
      "controlli": [
        { "glob": "**/*.js", "comando": "node --check {file}" }
      ],
      "collega_nel_worktree": ["node_modules"],
      "file_dipendenze": ["package.json"]
    }
  ],
  "gate": { "min": ["test", "controlli"], "std": ["test", "controlli", "lint"], "full": ["test", "controlli", "lint"] },
  "piattaforma": { "copia_wsl": "no" }
}
