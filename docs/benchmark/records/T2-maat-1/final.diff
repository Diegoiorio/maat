+func TestBigBytesPromotion(t *testing.T) {
+	// format also requires that the input is not modified (FR4).
+	format := func(in *big.Int) string {
+		before := (&big.Int{}).Set(in)
+		out := BigBytes(in)
+		if in.Cmp(before) != 0 {
+			t.Errorf("BigBytes modified its input: %v became %v", before, in)
+		}
+		return out
+	}
+	parseBack := func(out string, unit *big.Int) {
+		got, err := ParseBigBytes(out)
+		if err != nil {
+			t.Errorf("Couldn't parse %v: %v", out, err)
+		} else if got.Cmp(unit) != 0 {
+			t.Errorf("Expected %v for %v, got %v", unit, out, got)
+		}
+	}
+	one := big.NewInt(1)
+	mul := func(n int64, unit *big.Int) *big.Int {
+		return (&big.Int{}).Mul(big.NewInt(n), unit)
+	}
+	sub := func(a, b *big.Int) *big.Int {
+		return (&big.Int{}).Sub(a, b)
+	}
+
+	tl := testList{}
+	add := func(name, got, exp string) {
+		tl = append(tl, struct{ name, got, exp string }{name, got, exp})
+	}
+	for _, u := range []struct {
+		name     string
+		unit     *big.Int
+		nextName string
+		next     *big.Int
+	}{
+		{"kB", BigKByte, "MB", BigMByte},
+		{"MB", BigMByte, "GB", BigGByte},
+		{"GB", BigGByte, "TB", BigTByte},
+		{"TB", BigTByte, "PB", BigPByte},
+		{"PB", BigPByte, "EB", BigEByte},
+		{"EB", BigEByte, "ZB", BigZByte},
+		{"ZB", BigZByte, "YB", BigYByte},
+		{"YB", BigYByte, "RB", BigRByte},
+		{"RB", BigRByte, "QB", BigQByte},
+	} {
+		// 999.5 units: the smallest promoted input.
+		promoted := (&big.Int{}).Quo(mul(1999, u.unit), big.NewInt(2))
+		out := format(promoted)
+		add("BigBytes(999.5 "+u.name+" - 1)", format(sub(promoted, one)), "999 "+u.name)
+		add("BigBytes(999.5 "+u.name+")", out, "1.0 "+u.nextName)
+		parseBack(out, u.next)
+	}
+
+	out := format(sub(BigGByte, one))
+	add("BigBytes(1 GB - 1)", out, "1.0 GB")
+	parseBack(out, BigGByte)
+
+	add("BigBytes(1000 QB - 1)", format(sub(mul(1000, BigQByte), one)), "1000 QB")
+	add("BigBytes(1000 QB)", format(mul(1000, BigQByte)), "1000 QB")
+	add("BigBytes(5000 QB)", format(mul(5000, BigQByte)), "5000 QB")
+
+	tl.validateHere(t)
+}
