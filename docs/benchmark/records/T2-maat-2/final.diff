+// roundTripError reads out back with parse and returns an error unless the
+// value read is within one unit of out's last printed digit from in. That unit
+// is rounded up to a whole byte, because the parsers truncate to whole bytes.
+func roundTripError(out string, in *big.Int, parse func(string) (*big.Int, error)) error {
+	num, suffix, ok := strings.Cut(out, " ")
+	if !ok {
+		return fmt.Errorf("output %q has no unit", out)
+	}
+	read, err := parse(out)
+	if err != nil {
+		return fmt.Errorf("output %q does not parse: %v", out, err)
+	}
+	unit, err := parse("1 " + suffix)
+	if err != nil {
+		return fmt.Errorf("unit %q does not parse: %v", suffix, err)
+	}
+	_, frac, _ := strings.Cut(num, ".")
+	scale := new(big.Int).Exp(big.NewInt(10), big.NewInt(int64(len(frac))), nil)
+	tolerance := new(big.Int).Add(unit, scale)
+	tolerance.Sub(tolerance, big.NewInt(1))
+	tolerance.Div(tolerance, scale)
+	diff := new(big.Int).Sub(read, in)
+	if diff.Abs(diff).Cmp(tolerance) > 0 {
+		return fmt.Errorf("output %q reads back as %v, more than %v from %v", out, read, tolerance, in)
+	}
+	return nil
+}
+
+// parseBytesAsBig adapts ParseBytes to roundTripError.
+func parseBytesAsBig(s string) (*big.Int, error) {
+	v, err := ParseBytes(s)
+	if err != nil {
+		return nil, err
+	}
+	return new(big.Int).SetUint64(v), nil
+}
