+// bigTenths returns tenths/10 of unit.
+func bigTenths(tenths int64, unit *big.Int) *big.Int {
+	v := new(big.Int).Mul(big.NewInt(tenths), unit)
+	return v.Div(v, big.NewInt(10))
+}
+
+// bigTenthsLessOne returns one byte less than bigTenths.
+func bigTenthsLessOne(tenths int64, unit *big.Int) *big.Int {
+	v := bigTenths(tenths, unit)
+	return v.Sub(v, big.NewInt(1))
+}
