     out = click.utils._make_default_short_help(value, max_length)
     assert out == expect
+
+
+marker_prefix = pytest.mark.parametrize(
+    "prefix",
+    [
+        pytest.param("", id="plain"),
+        pytest.param("\n\b\n", id="no-wrap mark"),
+    ],
+)
+
+
+@pytest.mark.parametrize(
+    ("value", "max_length", "expect"),
+    [
+        pytest.param(
+            "Weigh apples vs. pears.",
+            30,
+            "Weigh apples vs. pears.",
+            id="abbreviation, next lowercase",
+        ),
+        pytest.param(
+            "Weigh apples vs. pears.",
+            23,
+            "Weigh apples vs. pears.",
+            id="exact fit",
+        ),
+        pytest.param(
+            "Pick a fruit. 3 remain.", 45, "Pick a fruit.", id="next starts with digit"
+        ),
+        pytest.param(
+            "Read e.g. the docs. Then go.",
+            45,
+            "Read e.g. the docs.",
+            id="abbreviation, then sentence end",
+        ),
+        pytest.param(
+            "Mix etc. and more", 45, "Mix etc. and more", id="no sentence end"
+        ),
+        pytest.param(
+            "See the U.S. Army now.", 45, "See the U.S.", id="next is capitalized"
+        ),
+        pytest.param(
+            "Stop here. (see below)", 45, "Stop here.", id="next starts uncased"
+        ),
+        pytest.param(
+            "Eat etc. \u00e9tude now.",
+            45,
+            "Eat etc. \u00e9tude now.",
+            id="next is non-ascii lowercase",
+        ),
+    ],
+)
+@marker_prefix
+def test_first_sentence_end(value, max_length, prefix, expect):
+    out = click.utils._make_default_short_help(prefix + value, max_length)
+    assert out == expect
+    assert len(out) <= max(max_length, 3)
+
+
+@pytest.mark.parametrize(
+    ("value", "max_length", "expect"),
+    [
