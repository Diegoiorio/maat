+func TestBigBytesOutputsParseBack(t *testing.T) {
+	limit := new(big.Int).Mul(BigQByte, big.NewInt(2000))
+	for _, s := range byteSizeSamples(limit) {
+		before := new(big.Int).Set(s)
+		for _, c := range []struct {
+			out, last string
+			base      float64
+		}{
+			{BigBytes(s), "QB", 1000},
+			{BigIBytes(s), "QiB", 1024},
+		} {
+			parsed, err := ParseBigBytes(c.out)
+			if err != nil {
+				t.Errorf("%v: couldn't parse %q: %v", s, c.out, err)
+				continue
+			}
+			checkParsedOutput(t, s, c.out, parsed, c.base, c.last)
+		}
+		if s.Cmp(before) != 0 {
+			t.Errorf("input changed from %v to %v", before, s)
+		}
+	}
+}
