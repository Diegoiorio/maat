+// There is no unit after QB and QiB, so their number can reach the base.
+func TestBigBytesLastUnit(t *testing.T) {
+	mul := func(u *big.Int, n int64) *big.Int {
+		return new(big.Int).Mul(u, big.NewInt(n))
+	}
+	half := func(u *big.Int, twice int64) *big.Int {
+		return new(big.Int).Rsh(mul(u, twice), 1)
+	}
+	testList{
+		{"999 QB", BigBytes(mul(BigQByte, 999)), "999 QB"},
+		{"999.5 QB - 1", BigBytes(new(big.Int).Sub(half(BigQByte, 1999), BigByte)), "999 QB"},
+		{"999.5 QB", BigBytes(half(BigQByte, 1999)), "1000 QB"},
+		{"1000 QB - 1", BigBytes(new(big.Int).Sub(mul(BigQByte, 1000), BigByte)), "1000 QB"},
+		{"1000 QB", BigBytes(mul(BigQByte, 1000)), "1000 QB"},
+		{"12345 QB", BigBytes(mul(BigQByte, 12345)), "12345 QB"},
+
+		{"1023 QiB", BigIBytes(mul(BigQiByte, 1023)), "1023 QiB"},
+		{"1023.5 QiB - 1", BigIBytes(new(big.Int).Sub(half(BigQiByte, 2047), BigByte)), "1023 QiB"},
+		{"1023.5 QiB", BigIBytes(half(BigQiByte, 2047)), "1024 QiB"},
+		{"1024 QiB - 1", BigIBytes(new(big.Int).Sub(mul(BigQiByte, 1024), BigByte)), "1024 QiB"},
+		{"1024 QiB", BigIBytes(mul(BigQiByte, 1024)), "1024 QiB"},
+		{"12345 QiB", BigIBytes(mul(BigQiByte, 12345)), "12345 QiB"},
+	}.validate(t)
+}
+
+func TestBigBytesDoesNotModifyInput(t *testing.T) {
+	for _, in := range []int64{0, 9, 999, 999_499, 999_500, 999_999, MiByte - 1, GiByte - 1, GByte} {
+		for name, f := range map[string]func(*big.Int) string{"BigBytes": BigBytes, "BigIBytes": BigIBytes} {
+			s := big.NewInt(in)
+			f(s)
+			if s.Int64() != in {
+				t.Errorf("%s changed its input from %d to %v", name, in, s)
+			}
+		}
+	}
+}
