+// Every boundary a Big function can reach: the largest input that stays in its
+// unit and the smallest one that is promoted, which is halfway to the next whole
+// number at the top of the unit.
+func TestBigBytesPromotion(t *testing.T) {
+	tests := []struct {
+		name  string
+		f     func(*big.Int) string
+		top   string
+		sizes []string
+		units []*big.Int
+		twice int64 // twice the number at which the rounding reaches the base
+	}{
+		{
+			"BigBytes", BigBytes, "999",
+			[]string{"kB", "MB", "GB", "TB", "PB", "EB", "ZB", "YB", "RB", "QB"},
+			[]*big.Int{BigKByte, BigMByte, BigGByte, BigTByte, BigPByte, BigEByte, BigZByte, BigYByte, BigRByte, BigQByte},
+			1999,
+		},
+		{
+			"BigIBytes", BigIBytes, "1023",
+			[]string{"KiB", "MiB", "GiB", "TiB", "PiB", "EiB", "ZiB", "YiB", "RiB", "QiB"},
+			[]*big.Int{BigKiByte, BigMiByte, BigGiByte, BigTiByte, BigPiByte, BigEiByte, BigZiByte, BigYiByte, BigRiByte, BigQiByte},
+			2047,
+		},
+	}
+	for _, tt := range tests {
+		for i := 0; i < len(tt.units)-1; i++ {
+			promote := new(big.Int).Mul(tt.units[i], big.NewInt(tt.twice))
+			promote.Rsh(promote, 1)
+			stay := new(big.Int).Sub(promote, BigByte)
+			almost := new(big.Int).Sub(tt.units[i+1], BigByte)
+
+			testList{
+				{tt.name + " stay", tt.f(stay), tt.top + " " + tt.sizes[i]},
+				{tt.name + " promote", tt.f(promote), "1.0 " + tt.sizes[i+1]},
+				{tt.name + " one below", tt.f(almost), "1.0 " + tt.sizes[i+1]},
+				{tt.name + " one", tt.f(tt.units[i+1]), "1.0 " + tt.sizes[i+1]},
+			}.validate(t)
+		}
+	}
+
+	testList{
+		{"BigBytes(1GB - 1)", BigBytes(big.NewInt(GByte - 1)), "1.0 GB"},
+		{"BigIBytes(1GiB - 1)", BigIBytes(big.NewInt(GiByte - 1)), "1.0 GiB"},
+
+		// Bytes are never rounded, so this boundary has no promoted input.
+		{"bbyte(999)", bbyte(999), "999 B"},
+		{"bbyte(1000)", bbyte(1000), "1.0 kB"},
+		{"bibyte(1023)", bibyte(1023), "1023 B"},
+		{"bibyte(1024)", bibyte(1024), "1.0 KiB"},
+	}.validate(t)
+}
+
+func TestBigBytesUnchanged(t *testing.T) {
+	testList{
+		{"bbyte(999499)", bbyte(999_499), "999 kB"},
+		{"bibyte(1000KiB)", bibyte(1000 * 1024), "1000 KiB"},
+		{"bibyte(1023KiB)", bibyte(1023 * 1024), "1023 KiB"},
+		{"bibyte(999.5KiB)", bibyte(999.5 * KiByte), "1000 KiB"},
+		// Carrying to 10.0 in the "%.1f" range is not a carry to the base.
+		{"bbyte(9999)", bbyte(9999), "10.0 kB"},
+		{"bibyte(10239)", bibyte(10239), "10.0 KiB"},
+	}.validate(t)
+
+	for s := uint64(0); s < 10; s++ {
