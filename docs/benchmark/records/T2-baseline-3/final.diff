+// checkParsedOutput verifies that out, the formatting of in, shows a number
+// below base unless its unit is the last one, and that parsed, the value read
+// back from it, is within one unit of its last printed digit.
+func checkParsedOutput(t *testing.T, in *big.Int, out string, parsed *big.Int, base float64, last string) {
+	t.Helper()
+	num, unit, ok := strings.Cut(out, " ")
+	if !ok {
+		t.Errorf("%v: malformed output %q", in, out)
+		return
+	}
+	v, err := strconv.ParseFloat(num, 64)
+	if err != nil {
+		t.Errorf("%v: malformed output %q: %v", in, out, err)
+		return
+	}
+	if v >= base && unit != last {
+		t.Errorf("%v: %q should have moved to the next unit", in, out)
+	}
+
+	one, err := ParseBigBytes("1 " + unit)
+	if err != nil {
+		t.Errorf("%v: unknown unit in %q: %v", in, out, err)
+		return
+	}
+	digit := new(big.Rat).SetInt(one)
+	if _, frac, ok := strings.Cut(num, "."); ok {
+		digit.Quo(digit, new(big.Rat).SetInt(new(big.Int).Exp(ten, big.NewInt(int64(len(frac))), nil)))
+	}
+	// The parsers return whole bytes, truncating, so nothing tighter than one
+	// byte can hold when the last digit is worth less than that.
+	if digit.Cmp(new(big.Rat).SetInt(BigByte)) < 0 {
+		digit.SetInt(BigByte)
+	}
+	diff := new(big.Rat).SetInt(new(big.Int).Sub(parsed, in))
+	if diff.Abs(diff).Cmp(digit) > 0 {
+		t.Errorf("%v: %q reads back as %v, more than %v away", in, out, parsed, digit.FloatString(1))
+	}
+}
+
+// byteSizeSamples returns inputs around every boundary between units, around
+// the points where the rounding carries to the next unit, and spread over the
+// whole range up to limit.
+func byteSizeSamples(limit *big.Int) []*big.Int {
+	var samples []*big.Int
+	add := func(s *big.Int) {
+		if s.Sign() >= 0 && s.Cmp(limit) <= 0 {
+			samples = append(samples, s)
+		}
+	}
+	for _, base := range []int64{1000, 1024} {
+		b := big.NewInt(base)
+		for u := big.NewInt(1); u.Cmp(limit) <= 0; u = new(big.Int).Mul(u, b) {
+			// One unit, and half a unit below it in the next smaller unit.
+			half := new(big.Int).Div(u, big.NewInt(2*base))
+			for _, c := range []*big.Int{u, new(big.Int).Sub(u, half)} {
+				for d := int64(-130); d <= 130; d++ {
+					add(new(big.Int).Add(c, big.NewInt(d)))
+				}
+			}
+		}
+	}
+	r := rand.New(rand.NewSource(1))
+	for i := 0; i < 2000; i++ {
+		add(new(big.Int).Rsh(new(big.Int).Rand(r, limit), uint(r.Intn(limit.BitLen()))))
+	}
+	return samples
+}
+
+func TestBytesOutputsParseBack(t *testing.T) {
+	limit := new(big.Int).SetUint64(1<<64 - 1)
+	for _, s := range byteSizeSamples(limit) {
+		u := s.Uint64()
+		for _, c := range []struct {
+			out, last string
+			base      float64
+		}{
+			{Bytes(u), "EB", 1000},
+			{IBytes(u), "EiB", 1024},
+			{BytesN(u, 0), "EB", 1000},
+			{BytesN(u, 1), "EB", 1000},
+			{BytesN(u, 2), "EB", 1000},
+			{BytesN(u, 3), "EB", 1000},
+			{BytesN(u, 4), "EB", 1000},
+			{BytesN(u, 6), "EB", 1000},
+		} {
+			// Near the top of the range the rounded output can exceed a uint64,
+			// which ParseBytes rejects by design (see TestByteErrors).
+			if exact, err := ParseBigBytes(c.out); err == nil && exact.Cmp(limit) > 0 {
+				continue
+			}
+			parsed, err := ParseBytes(c.out)
+			if err != nil {
+				t.Errorf("%d: couldn't parse %q: %v", u, c.out, err)
+				continue
+			}
+			checkParsedOutput(t, s, c.out, new(big.Int).SetUint64(parsed), c.base, c.last)
+		}
+	}
+}
