+// The rounded number reaching the base moves the output to the next unit. Each
+// pair of cases is the largest input that stays in its unit and the smallest
+// one that is promoted.
+func TestBytesPromotion(t *testing.T) {
+	testList{
+		// Bytes are never rounded, so this boundary has no promoted input.
+		{"bytes(999)", Bytes(999), "999 B"},
+		{"bytes(1000)", Bytes(1000), "1.0 kB"},
+
+		{"bytes(999.5kB - 1)", Bytes(999_499), "999 kB"},
+		{"bytes(999.5kB)", Bytes(999_500), "1.0 MB"},
+		{"bytes(1MB - 1)", Bytes(999_999), "1.0 MB"},
+
+		{"bytes(999.5MB - 1)", Bytes(999_499_999), "999 MB"},
+		{"bytes(999.5MB)", Bytes(999_500_000), "1.0 GB"},
+
+		{"bytes(999.5GB - 1)", Bytes(999_499_999_999), "999 GB"},
+		{"bytes(999.5GB)", Bytes(999_500_000_000), "1.0 TB"},
+
+		{"bytes(999.5TB - 1)", Bytes(999_499_999_999_999), "999 TB"},
+		{"bytes(999.5TB)", Bytes(999_500_000_000_000), "1.0 PB"},
+
+		// These inputs go through a float64 with a spacing of 128 here, so
+		// everything within 64 of the boundary already rounds onto it.
+		{"bytes(999.5PB - 65)", Bytes(999_500_000_000_000_000 - 65), "999 PB"},
+		{"bytes(999.5PB - 64)", Bytes(999_500_000_000_000_000 - 64), "1.0 EB"},
+		{"bytes(999.5PB)", Bytes(999_500_000_000_000_000), "1.0 EB"},
+
+		{"ibytes(1023)", IBytes(1023), "1023 B"},
+		{"ibytes(1024)", IBytes(1024), "1.0 KiB"},
+
+		{"ibytes(1023.5KiB - 1)", IBytes(1023.5*KiByte - 1), "1023 KiB"},
+		{"ibytes(1023.5KiB)", IBytes(1023.5 * KiByte), "1.0 MiB"},
+		{"ibytes(1MiB - 1)", IBytes(1_048_575), "1.0 MiB"},
+
+		{"ibytes(1023.5MiB - 1)", IBytes(1023.5*MiByte - 1), "1023 MiB"},
+		{"ibytes(1023.5MiB)", IBytes(1023.5 * MiByte), "1.0 GiB"},
+
+		{"ibytes(1023.5GiB - 1)", IBytes(1023.5*GiByte - 1), "1023 GiB"},
