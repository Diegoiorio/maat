# The plugin suites, one per line, in the order they run (short ones first, the long ones last).
# Read by tools/suite.sh (CI) and tools/giro-completo.sh. A name is plugins/maat/scripts/<name>.test.sh, except
# test-review-surface (plugins/maat/scripts/test-review-surface.sh); an entry with a / is a path from the repo root
# (tools/<name>.test.sh: the tests that make sense only in the repo). Resolved by suite_file, tools/lib/guardia-plugin.sh.
# tools/suite.sh refuses a list that misses a suite (of the plugin or tools/*.test.sh) or names a file that does not exist.
tools/suite.test.sh
maat-paths
maat-config
nomi_test
messages
gates
finalize
ciclo-worktree
context-pack
cycle-report
harness-merge
guard
stop-hook
blocks-independent
phase-events
test-review-surface
plan-check
bash-node
genericita
maat-doctor
senza-wsl
spazi
session-start
phase-usage
test-fast
counterproof
comandi-equivalenza
vitest-classify
tools/esempi-equiv.test.sh
tools/oracolo.test.sh
cycle-state
run-phase
driver
